<section class="coc7-luck-tracker">
  <div class="coc7-deco-banner">
    <span class="coc7-deco-line"></span>
    <span class="coc7-deco-diamond">&#9670;</span>
    <span class="coc7-deco-line"></span>
  </div>

  {{#if hasActors}}
    {{#each groups as |g|}}
      <div class="coc7-luck-group {{g.cssKey}}">
        <div class="coc7-luck-group-header">
          <h3 class="coc7-luck-group-title">{{localize g.label}}</h3>
          {{#if g.sub}}<span class="coc7-luck-group-sub">{{g.sub}}</span>{{/if}}
        </div>
        <table class="coc7-luck-table">
          <thead>
            <tr>
              <th class="coc7-luck-th-portrait"></th>
              <th>{{localize "COC7LUCK.ColName"}}</th>
              <th class="coc7-luck-th-value">{{localize "COC7LUCK.ColLuck"}}</th>
              <th class="coc7-luck-th-era">{{localize "COC7LUCK.ColEra"}}</th>
            </tr>
          </thead>
          <tbody>
            {{#each g.actors as |a|}}
              <tr class="{{#if a.isLowest}}coc7-luck-lowest{{/if}}">
                <td class="coc7-luck-portrait"><img src="{{a.img}}" alt="{{a.name}}" /></td>
                <td class="coc7-luck-name">{{a.name}}</td>
                <td class="coc7-luck-value">{{a.luckDisplay}}</td>
                <td class="coc7-luck-era-cell">
                  <select class="coc7-era-select" data-actor-id="{{a.id}}">
                    {{#each a.eraOptions as |o|}}
                      <option value="{{o.key}}" {{#if o.selected}}selected{{/if}}>{{localize o.label}}</option>
                    {{/each}}
                  </select>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
        <p class="coc7-luck-summary">
          {{localize "COC7LUCK.Lowest"}} : <strong>{{g.lowestDisplay}}</strong>
        </p>
      </div>
    {{/each}}
  {{else}}
    <p class="coc7-luck-empty">{{localize "COC7LUCK.NoActors"}}</p>
  {{/if}}

  <button type="button" data-action="refresh" class="coc7-luck-refresh">
    <span class="coc7-luck-refresh-icon"><i class="fa-solid fa-rotate"></i></span>
    {{localize "COC7LUCK.Refresh"}}
  </button>
</section>
